<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Discover Scatch and find your next favorite product."
    />
    <title>Scatch — Find your next favorite</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <main class="page">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Scatch home">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>scatch</span>
        </a>
        <a class="topbar-link" href="/users/login">Log in</a>
      </header>

      <section class="welcome" aria-labelledby="welcome-title">
        <div class="welcome-copy">
          <p class="eyebrow">A better way to discover</p>
          <h1 id="welcome-title">Good finds.<br /><span>Good feeling.</span></h1>
          <p class="intro">
            Welcome to Scatch. Sign in to pick up where you left off, or create
            an account and start exploring.
          </p>

          <div class="actions">
            <a class="button button-primary" href="/users/create">
              Create an account <span aria-hidden="true">→</span>
            </a>
            <a class="button button-secondary" href="/users/login">Log in</a>
          </div>
          <p class="footnote">New here? Creating an account is free.</p>
        </div>

        <div class="welcome-art" aria-hidden="true">
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="art-card">
            <span class="art-sparkle">✳</span>
            <span class="art-caption">YOUR NEXT<br />FAVORITE THING</span>
            <span class="art-arrow">↗</span>
          </div>
          <span class="art-dot dot-one"></span>
          <span class="art-dot dot-two"></span>
        </div>
      </section>

      <footer class="footer">
        <span>Discover something good.</span>
        <span>© Scatch</span>
      </footer>
    </main>
  </body>
</html>
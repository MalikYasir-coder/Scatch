<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create your account — Scatch</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="auth-body">
    <main class="auth-page">
      <a class="brand auth-brand" href="/" aria-label="Scatch home">
        <span class="brand-mark" aria-hidden="true">S</span>
        <span>scatch</span>
      </a>

      <section class="auth-card" aria-labelledby="auth-title">
        <p class="eyebrow">Start discovering</p>
        <h1 class="auth-title" id="auth-title">Create your account</h1>
        <p class="auth-intro">A few details and you’re ready to go.</p>

        <% if (error) { %>
          <p class="form-message form-error" role="alert"><%= error %></p>
        <% } %>

        <form class="auth-form" action="/users/create" method="post">
          <div class="form-field">
            <label for="fullname">Full name</label>
            <input
              id="fullname"
              name="fullname"
              type="text"
              autocomplete="name"
              minlength="3"
              maxlength="100"
              placeholder="Your name"
              required
            />
          </div>

          <div class="form-field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="form-field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="6"
              placeholder="At least 6 characters"
              required
            />
          </div>

          <button class="button button-primary auth-submit" type="submit">
            Create account <span aria-hidden="true">→</span>
          </button>
        </form>

        <p class="auth-switch">
          Already have an account? <a href="/users/login">Log in</a>
        </p>
      </section>
    </main>
  </body>
</html>

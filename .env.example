JWT_SECRET=replace-with-a-long-random-secret

# Email confirmations use Gmail SMTP. Create a Google App Password and keep it private.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# Twilio sends SMS only; it does not send the email confirmation.
# Use a Twilio number enabled for SMS delivery to Pakistan.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
